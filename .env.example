# Copy to .env with `cp .env.example .env` (install.sh does this for you).
# An empty value falls back to the built-in development default.
# Never commit .env.

# Signs the staff session cookie. install.sh generates a random value.
SESSION_SECRET=
# SQLAlchemy URL for the workshop database (relative SQLite file).
DATABASE_URL=sqlite:///./wheelwright.db
SESSION_COOKIE_NAME=wheelwright_session
# Session lifetime in seconds (12 hours).
SESSION_MAX_AGE=43200
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
# Port used by `python3 main.py`.
PORT=8000
